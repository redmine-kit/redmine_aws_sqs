#!/usr/bin/env bash
# The plugin as a gem, in Docker: builds the gems of this checkout and of
# redmine_aws, which it depends on, installs them into Redmine 7.0.3 as
# docs/setup.md#gem says (a gem line in Gemfile.local, then plugins/ linked
# to the installed gems), and boots Redmine through zeitwerk:check and in the
# production environment, which loads every file at start-up (eager_load).
# It fails when the gem misses a file that the checkout has.
#   bin/test-gem
#   TEST_RUBY=3.2 bin/test-gem   # on Ruby 3.2 (default 4.0)
#   REDMINE_AWS_DIR=<dir> bin/test-gem   # redmine_aws from <dir> (default ../redmine_aws)
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-aws-sqs-test
bin/services >/dev/null
aws_dir=${REDMINE_AWS_DIR:-../redmine_aws}
[[ -f "$aws_dir/init.rb" ]] || { echo "redmine_aws is not in $aws_dir; set REDMINE_AWS_DIR" >&2; exit 1; }
# test/Dockerfile on the Ruby of TEST_RUBY, as bin/test builds it.
ruby=$(sed -n 's/^FROM //p' "test/ruby-${TEST_RUBY:-4.0}.Dockerfile")
sed "s|^FROM ruby:[^ ]*|FROM $ruby|" test/Dockerfile |
  docker buildx build --load -q -t "$image" --build-context redmine_aws="$aws_dir" -f - . >/dev/null
docker run --rm --network redmine-aws-sqs-test_default "$image" sh -ec '
  for plugin in redmine_aws redmine_aws_sqs; do
    (cd "plugins/$plugin" && gem build --quiet "$plugin.gemspec" --output "/tmp/$plugin.gem")
    rm -r "plugins/$plugin"
  done
  gem install --local --no-document --quiet /tmp/redmine_aws.gem /tmp/redmine_aws_sqs.gem
  printf "%s\n" "gem '\''redmine_aws_sqs'\''" "gem '\''simplecov-cobertura'\'', group: :test" > Gemfile.local
  bundle install --prefer-local --quiet
  for plugin in redmine_aws redmine_aws_sqs; do
    ln -s "$(bundle info --path "$plugin")" "plugins/$plugin"
  done
  bin/rails db:drop db:create db:migrate redmine:plugins:migrate >/dev/null
  bin/rails zeitwerk:check
  # The production environment, which loads every file at start-up
  # (eager_load), on the test database.
  printf "%s\n" "production:" "  adapter: postgresql" "  host: postgres" "  database: redmine_test" \
    "  username: postgres" >> config/database.yml
  RAILS_ENV=production SECRET_KEY_BASE=test-gem bin/rails runner "
    plugin = Redmine::Plugin.find(:redmine_aws_sqs)
    dir = File.realpath(plugin.directory)
    abort %(redmine_aws_sqs is not the installed gem: #{dir}) unless dir.start_with?(Gem.dir)
    abort %(not eager loaded) unless Rails.application.config.eager_load
    puts %(redmine_aws_sqs #{plugin.version} from #{dir}: RedmineAws::SQS #{RedmineAws::SQS::VERSION})"'
