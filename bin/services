#!/usr/bin/env bash
# Starts the services of the tests, or stops them with --down, in Apple
# container when it runs, else in Docker (CONTAINER_CLI=container|docker
# chooses): PostgreSQL 16 (AWS Emulator, for SQS, comes with bin/test). No host ports: the tests run in a
# container on the same network.
#   bin/services                 # the services of bin/test
#   bin/services --screenshots   # also headless Chromium (bin/screenshots)
#   bin/services --down          # stops them
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
name=redmine-kit-aws-sqs-test
if [[ "$cli" == docker ]]; then
  compose=(docker compose -f test/compose.yml -p "$name")
  case "${1:-}" in
    --down) "${compose[@]}" --profile screenshots down -v; exit 0 ;;
    --screenshots) up=("${compose[@]}" --profile screenshots up -d --wait) ;;
    *) up=("${compose[@]}" up -d --wait) ;;
  esac
  if ! "${up[@]}"; then
    "${compose[@]}" ps -a >&2
    "${compose[@]}" logs --tail 80 >&2
    exit 1
  fi
  exit 0
fi

# Apple container: the services of test/compose.yml, with the images it pins,
# on the network $name; PostgreSQL also on $name-aws, the internal network of
# the plugin's tests (bin/aws_emulator), which bin/test starts.
image() { sed -n "s/^    image: //p" test/compose.yml | grep "^$1" | head -1; }
postgres=$name-postgres
chrome=$name-chrome
if [[ "${1:-}" == --down ]]; then
  source bin/aws_emulator
  aws_emulator_down
  container rm -f "$postgres" "$chrome" >/dev/null 2>&1 || true
  container network rm "$name" >/dev/null 2>&1 || true
  exit 0
fi
container network inspect "$name" >/dev/null 2>&1 || container network create "$name" >/dev/null
container network inspect "$name-aws" >/dev/null 2>&1 || container network create --internal "$name-aws" >/dev/null
if ! container_running "$postgres"; then
  container rm -f "$postgres" >/dev/null 2>&1 || true
  container run -d --name "$postgres" --network "$name" --network "$name-aws" -m 1G --progress none \
    -e POSTGRES_HOST_AUTH_METHOD=trust "$(image postgres)" >/dev/null
fi
if [[ "${1:-}" == --screenshots ]] && ! container_running "$chrome"; then
  container rm -f "$chrome" >/dev/null 2>&1 || true
  container run -d --name "$chrome" --network "$name" -m 3G --shm-size 2G --progress none \
    "$(image selenium/standalone-chromium)" >/dev/null
fi
for _ in $(seq 60); do
  if container exec "$postgres" pg_isready -q -U postgres &&
    { [[ "${1:-}" != --screenshots ]] || container exec "$chrome" /opt/bin/check-grid.sh --host 0.0.0.0 --port 4444 >/dev/null 2>&1; }; then
    exit 0
  fi
  sleep 2
done
echo "The services did not start: container logs $postgres (or $chrome)" >&2
exit 1
