#!/usr/bin/env bash
# Starts PostgreSQL 16 and moto for the tests (and LocalStack when
# LOCALSTACK_AUTH_TOKEN is set), or stops them with --down.
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f test/compose.yml -p redmine-serverless-sqs-test)
if [[ -n "${LOCALSTACK_AUTH_TOKEN:-}" ]]; then
  compose+=(--profile localstack)
fi
if [[ "${1:-}" == "--down" ]]; then
  "${compose[@]}" down -v
  exit 0
fi
if ! "${compose[@]}" up -d --wait; then
  "${compose[@]}" ps -a >&2
  "${compose[@]}" logs --tail 80 >&2
  exit 1
fi
