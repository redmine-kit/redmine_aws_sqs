#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, with SQS on AWS
# Emulator, in Apple container when it runs, else in Docker (CI;
# CONTAINER_CLI=container|docker chooses; docs/setup.md#tests).
#   bin/test                 # the plugin's tests, then the Redmine tests around jobs
#   bin/test --redmine       # also every Redmine test, with the plugin installed
#   bin/test <files>         # some files of the plugin's tests
#   REDMINE_KIT_AWS_DIR=<dir> bin/test   # redmine_kit_aws from <dir> (default ../redmine_kit_aws)
#   TEST_RUBY=3.2 bin/test   # on Ruby 3.2 (default 4.0), as the CI also does
#   COVERAGE=1 bin/test      # with the plugin's coverage in coverage/coverage.xml, as the CI does
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
source bin/test_slot
source bin/aws_emulator
trap 'release_test_slot; rm -rf "${aws_ca:-}"' EXIT
plugin=redmine_kit_aws_sqs
name=redmine-kit-aws-sqs-test
stop_services_at_exit "$name"
bin/services >/dev/null
# The plugin's tests run on the emulator's internal network, which cannot
# reach AWS (bin/aws_emulator). Redmine's own tests, which call no AWS API but
# resolve names on the internet (webhooks), run on the default network.
aws_emulator_up "plugins/$plugin/test"
echo "AWS for the tests: AWS Emulator $emulator_version"
aws+=(-e TEST_AWS_BACKEND=aws-emulator)
source bin/test_image
if [[ "$cli" == docker ]]; then
  network=(--network "${name}_default")
  opts=(-e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}")
else
  # PostgreSQL by its address on each network, and more memory than the 1 GB
  # a container gets by default.
  network=(--network "$kit_test_network" -e TEST_DATABASE_HOST="$(container_address "$name-postgres" "$kit_test_network")")
  aws+=(-e TEST_DATABASE_HOST="$(container_address "$name-postgres" "$kit_test_internal_network")")
  opts=(-m 4G -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-2}")
fi
# A database of this run's own (test/database.yml), dropped when the tests end.
db="redmine_test_$$"
setup='bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null'
teardown='; status=$?; bin/rails db:drop >/dev/null 2>&1; exit $status'
run() {
  "$cli" run --rm "${run_opts[@]}" "${network[@]}" "${opts[@]}" -e TEST_DATABASE="$db" "$image" \
    sh -c "$setup"' && "$@"'"$teardown" test "$@"
}
# The plugin's tests, on the emulator's network; with COVERAGE set, in one
# process with the coverage written to coverage/coverage.xml
# (test/test_helper.rb). COVERAGE itself is not passed on: Redmine's test
# helper would start a SimpleCov of its own.
run_plugin() {
  local cov=()
  if [[ -n "${COVERAGE:-}" ]]; then
    rm -f coverage/.resultset.json && mkdir -p coverage
    cov=(-e PLUGIN_COVERAGE=1 -e PARALLEL_WORKERS=1 -v "$PWD/coverage:/redmine/plugins/$plugin/coverage")
  fi
  "$cli" run --rm "${run_opts[@]}" "${aws[@]}" "${opts[@]}" ${cov[@]+"${cov[@]}"} -e TEST_DATABASE="$db" "$image" \
    sh -c "$aws_forward$setup"' && "$@"'"$teardown" test "$@"
}
redmine_tests=(test/unit/mailer_test.rb test/unit/project_test.rb test/unit/webhook_test.rb
  test/functional/admin_controller_test.rb test/functional/projects_controller_test.rb)
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test "plugins/$plugin/test"
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/$plugin/}"
else
  run_plugin bin/rails test "plugins/$plugin/test"
  run bin/rails test "${redmine_tests[@]}"
fi
