#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, with AWS on LocalStack
# (when LOCALSTACK_AUTH_TOKEN is set) or moto, in Docker.
#   bin/test                 # the plugin's tests, then the Redmine tests around jobs
#   bin/test --redmine       # also every Redmine test, with the plugin installed
#   bin/test <files>         # some files of the plugin's tests
#   REDMINE_AWS_DIR=<dir> bin/test   # redmine_aws from <dir> (default ../redmine_aws)
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-aws-sqs-test
# The same tests run against either backend; TEST_AWS_BACKEND names it.
if [[ -n "${LOCALSTACK_AUTH_TOKEN:-}" ]]; then
  backend=localstack endpoint=http://localstack:4566
else
  backend=moto endpoint=http://moto:5000
fi
echo "AWS backend: $backend ($endpoint)"
bin/services >/dev/null
# redmine_aws, which the plugin requires: a checkout next to this one, or
# REDMINE_AWS_DIR.
aws_dir=${REDMINE_AWS_DIR:-../redmine_aws}
[[ -f "$aws_dir/init.rb" ]] || { echo "redmine_aws is not in $aws_dir; set REDMINE_AWS_DIR" >&2; exit 1; }
# test/Dockerfile on its Ruby (4.0), or on RUBY_IMAGE in place of its FROM
# ruby line (the CI also runs Ruby 3.2).
dockerfile() {
  if [[ -n "${RUBY_IMAGE:-}" ]]; then
    sed "s|^FROM ruby:[^ ]*|FROM $RUBY_IMAGE|" test/Dockerfile
  else
    cat test/Dockerfile
  fi
}
dockerfile | docker buildx build --load -q -t "$image" --build-context redmine_aws="$aws_dir" -f - . >/dev/null
run() {
  docker run --rm --network redmine-aws-sqs-test_default -e AWS_ENDPOINT_URL="$endpoint" -e TEST_AWS_BACKEND="$backend" \
    -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" \
    sh -c 'bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null && "$@"' test "$@"
}
# The plugin's tests, with coverage written to coverage/coverage.xml.
run_plugin() {
  mkdir -p coverage
  docker run --rm --network redmine-aws-sqs-test_default -e AWS_ENDPOINT_URL="$endpoint" -e TEST_AWS_BACKEND="$backend" \
    -e PLUGIN_COVERAGE=1 -e PARALLEL_WORKERS=1 -v "$PWD/coverage:/redmine/plugins/redmine_aws_sqs/coverage" "$image" \
    sh -c 'bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null && "$@"' test "$@"
}
redmine_tests=(test/unit/mailer_test.rb test/unit/project_test.rb test/unit/webhook_test.rb
  test/functional/admin_controller_test.rb test/functional/projects_controller_test.rb)
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test plugins/redmine_aws_sqs/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/redmine_aws_sqs/}"
else
  run_plugin bin/rails test plugins/redmine_aws_sqs/test
  run bin/rails test "${redmine_tests[@]}"
fi
