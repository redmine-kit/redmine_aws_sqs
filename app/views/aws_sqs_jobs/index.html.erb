<%= render partial: 'aws_admin/tabs', locals: { selected: 'jobs' } %>
<% content_for :header_tags do %>
  <%# Redmine's toggle of the list's checkboxes (the check box in the header row) %>
  <%= javascript_include_tag 'context_menu' %>
<% end %>

<% unless @enabled %>
<p class="warning"><%= l(:text_aws_sqs_jobs_disabled) %></p>
<% end %>

<% if @enabled %>
<h3><%= l(:label_aws_sqs_jobs_queue) %></h3>

<% if @counts && @counts[:dead_letter].to_i.positive? %>
<p><%= link_to sprite_icon('reload', l(:button_aws_sqs_jobs_redrive)), aws_sqs_jobs_redrive_path, method: :post, data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-reload' %></p>
<% end %>

<% if @counts_error %>
<div class="flash error"><%= @counts_error %></div>
<% else %>
<%= render partial: 'aws_admin/values', locals: { rows: aws_sqs_jobs_count_rows(@counts) } %>
<% end %>
<% end %>

<h3><%= l(:label_aws_sqs_jobs_failures) %></h3>

<p>
  <%= link_to_unless params[:mail] != '1', l(:label_all), action: 'index' %> |
  <%= link_to_unless params[:mail] == '1', l(:label_aws_sqs_jobs_mail_only), action: 'index', mail: '1' %>
</p>

<% if @failures.any? %>
<%= form_tag({ action: 'resend' }, method: :post, id: 'aws-sqs-job-failures') do %>
<div class="autoscroll">
<table class="list jobs"><thead>
<tr>
    <th class="checkbox hide-when-print">
      <%= check_box_tag 'check_all', '', false, class: 'toggle-selection', title: "#{l(:button_check_all)}/#{l(:button_uncheck_all)}" %>
    </th>
    <th><%= l(:label_aws_sqs_jobs_job) %></th>
    <th><%= l(:label_aws_sqs_jobs_error) %></th>
    <th><%= l(:label_aws_sqs_jobs_attempts) %></th>
    <th><%= l(:label_aws_sqs_jobs_enqueued_at) %></th>
    <th><%= l(:label_aws_sqs_jobs_failed_at) %></th>
</tr></thead>
<tbody>
<% @failures.each do |failure| %>
<tr id="failure-<%= failure.id %>">
    <td class="checkbox hide-when-print"><%= check_box_tag 'ids[]', failure.id, false, id: nil %></td>
    <td class="subject"><%= failure.summary %></td>
    <td class="description"><%= failure.error_class %></td>
    <td><%= failure.attempts %></td>
    <td><%= failure.enqueued_at ? format_time(failure.enqueued_at) : '-' %></td>
    <td><%= format_time(failure.failed_at) %></td>
</tr>
<% end %>
</tbody>
</table>
</div>
<p>
  <%= submit_tag l(:button_aws_sqs_jobs_resend), disabled: !@enabled, data: { confirm: l(:text_are_you_sure) } %>
  <%= submit_tag l(:button_delete), formaction: url_for(action: 'destroy'), data: { confirm: l(:text_are_you_sure) } %>
</p>
<% end %>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
